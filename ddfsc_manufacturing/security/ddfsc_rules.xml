<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        A user with a Department on their user form sees only that department.
        A user without one is a cross-department role (managers, quality,
        planning) and sees every department, as the user form explains.
    -->
    <record id="rule_ddfsc_store_request_department" model="ir.rule">
        <field name="name">Store requests of the user's department</field>
        <field name="model_id" ref="model_ddfsc_store_request"/>
        <field name="domain_force">user.ddfsc_department and [('ddfsc_department', '=', user.ddfsc_department)] or [(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>
    <record id="rule_ddfsc_store_request_manager" model="ir.rule">
        <field name="name">Operation manager sees every store request</field>
        <field name="model_id" ref="model_ddfsc_store_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ddfsc_manufacturing.group_ddfsc_operation_manager'))]"/>
    </record>
    <record id="rule_ddfsc_production_department" model="ir.rule">
        <field name="name">Manufacturing orders of the user's department</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="domain_force">user.ddfsc_department and [('ddfsc_department', '=', user.ddfsc_department)] or [(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>
    <record id="rule_ddfsc_production_manager" model="ir.rule">
        <field name="name">Operation manager sees every manufacturing order</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ddfsc_manufacturing.group_ddfsc_operation_manager'))]"/>
    </record>
    <record id="rule_ddfsc_variance_department" model="ir.rule">
        <field name="name">Consumption variance of the user's department</field>
        <field name="model_id" ref="model_ddfsc_production_variance_line"/>
        <field name="domain_force">user.ddfsc_department and [('department', '=', user.ddfsc_department)] or [(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>
    <record id="rule_ddfsc_variance_manager" model="ir.rule">
        <field name="name">Operation manager sees every consumption variance</field>
        <field name="model_id" ref="model_ddfsc_production_variance_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('ddfsc_manufacturing.group_ddfsc_operation_manager'))]"/>
    </record>
</odoo>
