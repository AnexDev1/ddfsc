<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_ddfsc" model="ir.ui.view">
        <field name="name">product.template.form.ddfsc</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex">
                    <field name="ddfsc_is_flour"/>
                    <label for="ddfsc_is_flour"/>
                </span>
                <span class="d-inline-flex">
                    <field name="ddfsc_is_byproduct"/>
                    <label for="ddfsc_is_byproduct"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>
