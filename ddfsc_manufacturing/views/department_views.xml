<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_ddfsc_department" model="ir.ui.view">
        <field name="name">res.users.form.ddfsc.department</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="ddfsc_department"/>
            </xpath>
        </field>
    </record>

    <record id="view_ddfsc_department_quant_list" model="ir.ui.view">
        <field name="name">ddfsc.department.quant.list</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="lot_id" optional="show"/>
                <field name="quantity"/>
                <field name="reserved_quantity"/>
                <field name="product_uom_id"/>
            </list>
        </field>
    </record>

    <record id="view_ddfsc_store_request_list" model="ir.ui.view">
        <field name="name">ddfsc.store.request.list</field>
        <field name="model">ddfsc.store.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_request"/>
                <field name="location_dest_id"/>
                <field name="ddfsc_department"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="picking_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ddfsc_store_request_form" model="ir.ui.view">
        <field name="name">ddfsc.store.request.form</field>
        <field name="model">ddfsc.store.request</field>
        <field name="arch" type="xml">
            <form string="Store Transfer Requests">
                <header>
                    <button name="action_submit_to_manager" type="object" string="Submit to Manager" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve_manager" type="object" string="Approve" class="btn-primary"
                            groups="ddfsc_manufacturing.group_ddfsc_operation_manager"
                            invisible="state != 'store_manager'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'store_manager', 'requested')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,store_manager,requested,received"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object" class="oe_stat_button" icon="fa-truck"
                                invisible="not picking_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Transfer</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="location_dest_id" readonly="state != 'draft'"/>
                            <field name="date_request" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="ddfsc_user_department" invisible="1"/>
                            <field name="ddfsc_department" readonly="state != 'draft' or ddfsc_user_department"/>
                            <field name="location_id" readonly="state != 'draft'"
                                   string="Default Source"/>
                            <field name="user_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="picking_id" invisible="not picking_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Product Details" name="product_details">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_uom_id"/>
                                    <field name="location_id"/>
                                    <field name="qty_available"/>
                                    <field name="product_uom_qty"/>
                                    <field name="lot_id" optional="show"
                                           context="{'default_product_id': product_id}"/>
                                    <field name="company_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ddfsc_store_requests" model="ir.actions.act_window">
        <field name="name">Store Transfer Requests</field>
        <field name="res_model">ddfsc.store.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Available flour -->
    <record id="action_ddfsc_pasta_flour" model="ir.actions.act_window">
        <field name="name">Available Flour</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ddfsc_department_quant_list"/>
        <field name="domain" eval="[('quantity', '>', 0), ('product_id.ddfsc_is_flour', '=', True), ('location_id', 'in', [ref('loc_flour_pasta'), ref('loc_flour_macaroni')])]"/>
    </record>
    <record id="action_ddfsc_bread_flour" model="ir.actions.act_window">
        <field name="name">Available Flour</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ddfsc_department_quant_list"/>
        <field name="domain" eval="[('quantity', '>', 0), ('product_id.ddfsc_is_flour', '=', True), ('location_id', '=', ref('loc_bread'))]"/>
    </record>
    <record id="action_ddfsc_biscuit_flour" model="ir.actions.act_window">
        <field name="name">Available Flour</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ddfsc_department_quant_list"/>
        <field name="domain" eval="[('quantity', '>', 0), ('product_id.ddfsc_is_flour', '=', True), ('location_id', '=', ref('loc_biscuit'))]"/>
    </record>
    <record id="action_ddfsc_flour_wheat" model="ir.actions.act_window">
        <field name="name">Available Wheat</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ddfsc_department_quant_list"/>
        <field name="domain" eval="[('quantity', '>', 0), ('product_id.product_tmpl_id', '=', ref('product_wheat')), ('location_id', 'in', [ref('loc_silo_pasta'), ref('loc_silo_macaroni'), ref('loc_silo_bread'), ref('loc_silo_biscuit')])]"/>
    </record>

    <!-- Temp finished products -->
    <record id="action_ddfsc_pasta_temp" model="ir.actions.act_window">
        <field name="name">Temp Finished Products</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ddfsc_department_quant_list"/>
        <field name="domain" eval="[('quantity', '>', 0), ('location_id', 'in', [ref('loc_pasta_finished'), ref('loc_macaroni_finished')]), ('product_id.product_tmpl_id', 'in', [ref('product_pasta_long'), ref('product_pasta_short')])]"/>
    </record>
    <record id="action_ddfsc_bread_temp" model="ir.actions.act_window">
        <field name="name">Temp Finished Products</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ddfsc_department_quant_list"/>
        <field name="domain" eval="[('quantity', '>', 0), ('location_id', '=', ref('loc_bread')), ('product_id.product_tmpl_id', 'in', [ref('product_bread_market'), ref('product_bread_university')])]"/>
    </record>
    <record id="action_ddfsc_biscuit_temp" model="ir.actions.act_window">
        <field name="name">Temp Finished Products</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ddfsc_department_quant_list"/>
        <field name="domain" eval="[('quantity', '>', 0), ('location_id', '=', ref('loc_biscuit')), ('product_id.product_tmpl_id', 'in', [ref('product_zebib'), ref('product_defense')])]"/>
    </record>
    <record id="action_ddfsc_flour_temp" model="ir.actions.act_window">
        <field name="name">Temp Finished Products</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ddfsc_department_quant_list"/>
        <field name="domain" eval="[('quantity', '>', 0), ('location_id', 'in', [ref('loc_flour'), ref('loc_mill')]), ('product_id.product_tmpl_id', 'in', [ref('product_flour_g1'), ref('product_flour_g2'), ref('product_flour_scp'), ref('product_flour_lcp')])]"/>
    </record>

    <!-- Store request (per department) -->
    <record id="action_ddfsc_pasta_request" model="ir.actions.act_window">
        <field name="name">Store Transfer Requests</field>
        <field name="res_model">ddfsc.store.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ddfsc_department', '=', 'pasta')]</field>
        <field name="context">{'default_ddfsc_department': 'pasta'}</field>
    </record>
    <record id="action_ddfsc_bread_request" model="ir.actions.act_window">
        <field name="name">Store Transfer Requests</field>
        <field name="res_model">ddfsc.store.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ddfsc_department', '=', 'bread')]</field>
        <field name="context">{'default_ddfsc_department': 'bread'}</field>
    </record>
    <record id="action_ddfsc_biscuit_request" model="ir.actions.act_window">
        <field name="name">Store Transfer Requests</field>
        <field name="res_model">ddfsc.store.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ddfsc_department', '=', 'biscuit')]</field>
        <field name="context">{'default_ddfsc_department': 'biscuit'}</field>
    </record>
    <record id="action_ddfsc_flour_request" model="ir.actions.act_window">
        <field name="name">Store Transfer Requests</field>
        <field name="res_model">ddfsc.store.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ddfsc_department', '=', 'flour')]</field>
        <field name="context">{'default_ddfsc_department': 'flour'}</field>
    </record>

    <!-- Manufacturing orders -->
    <record id="action_ddfsc_pasta_mo" model="ir.actions.act_window">
        <field name="name">Manufacturing Orders</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="mrp.view_mrp_production_filter"/>
        <field name="domain">[('ddfsc_line_id.code', 'in', ['PASTA', 'MAC'])]</field>
        <field name="context">{'search_default_todo': True, 'ddfsc_department': 'pasta'}</field>
    </record>
    <record id="action_ddfsc_bread_mo" model="ir.actions.act_window">
        <field name="name">Manufacturing Orders</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="mrp.view_mrp_production_filter"/>
        <field name="domain">[('ddfsc_line_id.code', '=', 'BREAD')]</field>
        <field name="context">{'search_default_todo': True, 'ddfsc_department': 'bread'}</field>
    </record>
    <record id="action_ddfsc_biscuit_mo" model="ir.actions.act_window">
        <field name="name">Manufacturing Orders</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="mrp.view_mrp_production_filter"/>
        <field name="domain">[('ddfsc_line_id.code', 'in', ['BISC-CN', 'BISC-OR'])]</field>
        <field name="context">{'search_default_todo': True, 'ddfsc_department': 'biscuit'}</field>
    </record>
    <record id="action_ddfsc_flour_mo" model="ir.actions.act_window">
        <field name="name">Manufacturing Orders</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="mrp.view_mrp_production_filter"/>
        <field name="domain">[('ddfsc_line_id.code', '=', 'MILL')]</field>
        <field name="context">{'search_default_todo': True, 'ddfsc_department': 'flour'}</field>
    </record>

    <menuitem id="menu_ddfsc_store_requests"
              name="Store Transfer Requests"
              parent="mrp.menu_mrp_root"
              action="action_ddfsc_store_requests"
              sequence="5"
              groups="mrp.group_mrp_user"/>

    <menuitem id="menu_ddfsc_dept_pasta" name="Pasta" parent="mrp.menu_mrp_root" sequence="10" groups="mrp.group_mrp_user"/>
    <menuitem id="menu_ddfsc_dept_pasta_flour" name="Available Flour" parent="menu_ddfsc_dept_pasta" action="action_ddfsc_pasta_flour" sequence="10"/>
    <menuitem id="menu_ddfsc_dept_pasta_temp" name="Temp Finished Products" parent="menu_ddfsc_dept_pasta" action="action_ddfsc_pasta_temp" sequence="20"/>
    <menuitem id="menu_ddfsc_dept_pasta_request" name="Store Transfer Requests" parent="menu_ddfsc_dept_pasta" action="action_ddfsc_pasta_request" sequence="30"/>
    <menuitem id="menu_ddfsc_dept_pasta_mo" name="Manufacturing Orders" parent="menu_ddfsc_dept_pasta" action="action_ddfsc_pasta_mo" sequence="40"/>

    <menuitem id="menu_ddfsc_dept_bread" name="Bread" parent="mrp.menu_mrp_root" sequence="20" groups="mrp.group_mrp_user"/>
    <menuitem id="menu_ddfsc_dept_bread_flour" name="Available Flour" parent="menu_ddfsc_dept_bread" action="action_ddfsc_bread_flour" sequence="10"/>
    <menuitem id="menu_ddfsc_dept_bread_temp" name="Temp Finished Products" parent="menu_ddfsc_dept_bread" action="action_ddfsc_bread_temp" sequence="20"/>
    <menuitem id="menu_ddfsc_dept_bread_request" name="Store Transfer Requests" parent="menu_ddfsc_dept_bread" action="action_ddfsc_bread_request" sequence="30"/>
    <menuitem id="menu_ddfsc_dept_bread_mo" name="Manufacturing Orders" parent="menu_ddfsc_dept_bread" action="action_ddfsc_bread_mo" sequence="40"/>

    <menuitem id="menu_ddfsc_dept_biscuit" name="Biscuit" parent="mrp.menu_mrp_root" sequence="30" groups="mrp.group_mrp_user"/>
    <menuitem id="menu_ddfsc_dept_biscuit_flour" name="Available Flour" parent="menu_ddfsc_dept_biscuit" action="action_ddfsc_biscuit_flour" sequence="10"/>
    <menuitem id="menu_ddfsc_dept_biscuit_temp" name="Temp Finished Products" parent="menu_ddfsc_dept_biscuit" action="action_ddfsc_biscuit_temp" sequence="20"/>
    <menuitem id="menu_ddfsc_dept_biscuit_request" name="Store Transfer Requests" parent="menu_ddfsc_dept_biscuit" action="action_ddfsc_biscuit_request" sequence="30"/>
