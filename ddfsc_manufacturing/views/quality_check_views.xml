<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ddfsc_quality_check_view_list" model="ir.ui.view">
        <field name="name">ddfsc.quality.check.list</field>
        <field name="model">ddfsc.quality.check</field>
        <field name="arch" type="xml">
            <list>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="check_type"/>
                <field name="measured_value"/>
                <field name="apply_min"/>
                <field name="standard_min"/>
                <field name="apply_max"/>
                <field name="standard_max"/>
                <field name="result"/>
                <field name="production_id"/>
            </list>
        </field>
    </record>

    <record id="ddfsc_quality_check_action" model="ir.actions.act_window">
        <field name="name">Quality Checks</field>
        <field name="res_model">ddfsc.quality.check</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ddfsc_quality_check"
              name="Quality Checks"
              parent="mrp.menu_mrp_manufacturing"
              action="ddfsc_quality_check_action"
              sequence="25"/>
</odoo>
