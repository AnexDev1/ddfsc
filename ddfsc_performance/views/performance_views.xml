<odoo>
 <record id="action_performance_evaluation" model="ir.actions.act_window"><field name="name">Performance Evaluations</field><field name="res_model">ddfsc.performance.evaluation</field><field name="view_mode">list,form,pivot,graph</field></record>
 <record id="action_performance_cycle" model="ir.actions.act_window"><field name="name">Evaluation Cycles</field><field name="res_model">ddfsc.performance.cycle</field><field name="view_mode">list,form</field></record>
 <record id="action_performance_template" model="ir.actions.act_window"><field name="name">Evaluation Templates</field><field name="res_model">ddfsc.performance.template</field><field name="view_mode">list,form</field></record>
 <record id="action_performance_goal" model="ir.actions.act_window"><field name="name">Employee Goals</field><field name="res_model">ddfsc.performance.goal</field><field name="view_mode">list,form,pivot,graph</field></record>
 <record id="view_performance_evaluation_list" model="ir.ui.view"><field name="name">ddfsc.performance.evaluation.list</field><field name="model">ddfsc.performance.evaluation</field><field name="arch" type="xml"><list><field name="employee_id"/><field name="cycle_id"/><field name="manager_id"/><field name="final_score"/><field name="rating" widget="badge"/><field name="state" widget="badge"/></list></field></record>
 <record id="view_performance_evaluation_form" model="ir.ui.view"><field name="name">ddfsc.performance.evaluation.form</field><field name="model">ddfsc.performance.evaluation</field><field name="arch" type="xml"><form><header><button name="action_start" type="object" string="Start Self Assessment" class="btn-primary" invisible="state != 'draft'"/><button name="action_submit_self" type="object" string="Submit Self Assessment" class="btn-primary" invisible="state != 'self_assessment'"/><button name="action_submit_supervisor" type="object" string="Submit Supervisor Review" class="btn-primary" invisible="state != 'supervisor_review'"/><button name="action_finalize" type="object" string="HR Finalize" class="btn-primary" groups="hr.group_hr_manager" invisible="state != 'hr_review'"/><field name="state" widget="statusbar" statusbar_visible="draft,self_assessment,supervisor_review,hr_review,finalized"/></header><sheet><div class="oe_title"><h1>Performance Evaluation</h1></div><group><group><field name="employee_id" readonly="state != 'draft'"/><field name="cycle_id" readonly="state != 'draft'"/><field name="template_id" readonly="state != 'draft'"/></group><group><field name="manager_id"/><field name="final_score" readonly="1"/><field name="rating" readonly="1" widget="badge"/></group></group><field name="line_ids" readonly="state == 'finalized'"><list editable="bottom" create="0" delete="0"><field name="name"/><field name="target"/><field name="weight"/><field name="self_score"/><field name="supervisor_score"/><field name="self_comment" optional="hide"/><field name="supervisor_comment" optional="hide"/></list></field><notebook><page string="Self Assessment"><field name="self_comment" readonly="state not in ('self_assessment','supervisor_review')"/></page><page string="Supervisor Review"><field name="supervisor_comment" readonly="state not in ('supervisor_review','hr_review')"/></page><page string="HR Finalization"><field name="hr_comment" readonly="state not in ('hr_review','finalized')"/></page></notebook></sheet><chatter/></form></field></record>
 <record id="view_performance_cycle_form" model="ir.ui.view"><field name="name">ddfsc.performance.cycle.form</field><field name="model">ddfsc.performance.cycle</field><field name="arch" type="xml"><form><header><button name="action_open" type="object" string="Open Cycle" class="btn-primary" invisible="state != 'draft'"/><button name="action_close" type="object" string="Close Cycle" invisible="state != 'open'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="date_start"/><field name="date_end"/></group></sheet><chatter/></form></field></record>
 <record id="view_performance_template_form" model="ir.ui.view"><field name="name">ddfsc.performance.template.form</field><field name="model">ddfsc.performance.template</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="active"/></group><field name="line_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="target"/><field name="weight"/><field name="description" optional="hide"/></list></field></sheet></form></field></record>
 <record id="view_performance_goal_form" model="ir.ui.view"><field name="name">ddfsc.performance.goal.form</field><field name="model">ddfsc.performance.goal</field><field name="arch" type="xml"><form><header><button name="action_agree" type="object" string="Manager Agree" class="btn-primary" invisible="state != 'draft'"/><button name="action_complete" type="object" string="Mark Completed" invisible="state != 'agreed'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="employee_id"/><field name="cycle_id"/><field name="weight"/><field name="progress"/></group><field name="name"/><field name="target"/><field name="manager_comment"/></sheet><chatter/></form></field></record>
 <menuitem id="menu_performance_root" name="Performance" parent="hr.menu_hr_root" sequence="45" groups="hr.group_hr_user"/>
 <menuitem id="menu_performance_evaluations" name="Evaluations" parent="menu_performance_root" action="action_performance_evaluation" sequence="10" groups="hr.group_hr_user"/>
 <menuitem id="menu_performance_cycles" name="Evaluation Cycles" parent="menu_performance_root" action="action_performance_cycle" sequence="20" groups="hr.group_hr_manager"/>
 <menuitem id="menu_performance_templates" name="Evaluation Templates" parent="menu_performance_root" action="action_performance_template" sequence="30" groups="hr.group_hr_manager"/>
 <menuitem id="menu_performance_goals" name="Employee Goals" parent="menu_performance_root" action="action_performance_goal" sequence="15" groups="hr.group_hr_user"/>
</odoo>
