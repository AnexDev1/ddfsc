<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Product Stock List View to customize buttons and columns -->
    <record id="product_product_stock_tree_inherit_custom" model="ir.ui.view">
        <field name="name">product.product.stock.list.inherit.custom</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_product_stock_tree"/>
        <field name="arch" type="xml">
            <!-- Replace standard Inventory at Date button with our range wizard action -->
            <xpath expr="//header/button[@name='%(stock.action_inventory_at_date)d']" position="replace">
                <button name="%(inventory.action_inventory_at_date_range)d"
                        string="Inventory at Date Range"
                        type="action"
                        class="btn-primary ms-1"
                        display="always"/>
            </xpath>
            <!-- Hide Free to Use column -->
            <xpath expr="//field[@name='free_qty']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <!-- Remove New button from list view -->
            <xpath expr="//list" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>
            <!-- Add Product Code and Name separated for Excel export -->
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="default_code" string="Product Code" optional="show"/>
                <field name="name" string="Product Name" optional="show"/>
            </xpath>
            <!-- Hide the merged Display Name by default so it's not exported -->
            <xpath expr="//field[@name='display_name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inherit Moves History list view to add "At Date Range" button in header -->
    <record id="view_move_line_tree_inherit_date_range" model="ir.ui.view">
        <field name="name">stock.move.line.list.inherit.date.range</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <!-- Add header button for date range filter -->
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(inventory.action_move_history_date_range)d"
                            string="At Date Range"
                            type="action"
                            class="btn-primary ms-1"
                            display="always"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- Inherit Moves Analysis list view to add "At Date Range" button in header -->
    <record id="view_move_tree_inherit_date_range" model="ir.ui.view">
        <field name="name">stock.move.list.inherit.date.range</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(inventory.action_move_analysis_date_range)d"
                            string="At Date Range"
                            type="action"
                            class="btn-primary ms-1"
                            display="always"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- Force Move Analysis to open in List View by default -->
    <record id="stock.stock_move_action" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,pivot,graph,form</field>
    </record>

    <!-- Odoo hardcodes the pivot view to sequence 1 and list to 3 for this action. We must override the list view sequence to 0 to make it the default! -->
    <record id="stock.action_stock_move_tree_all" model="ir.actions.act_window.view">
        <field name="sequence" eval="0"/>
    </record>

    <!-- Inject the split columns into the Stock Report (Locations) update valuation view -->
    <record id="view_stock_quant_tree_split_export" model="ir.ui.view">
        <field name="name">stock.quant.list.split.export</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_code" optional="show"/>
                <field name="product_name_only" optional="show"/>
            </xpath>
            <!-- Hide the standard combined product_id by default so it's not exported, but leave it optional -->
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inject the split columns into the Stock Report (Locations) view -->
    <record id="view_stock_quant_tree_simple_split_export" model="ir.ui.view">
        <field name="name">stock.quant.list.simple.split.export</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_simple"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_code" optional="show"/>
                <field name="product_name_only" optional="show"/>
            </xpath>
            <!-- Hide the standard combined product_id by default so it's not exported, but leave it optional -->
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>
</odoo>
