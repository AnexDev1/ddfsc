<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="weighbridge_scale_list" model="ir.ui.view">
        <field name="name">ddfsc.weighbridge.scale.list</field>
        <field name="model">ddfsc.weighbridge.scale</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="model"/>
                <field name="is_online" widget="boolean_toggle" readonly="1"/>
                <field name="last_weight"/>
                <field name="last_stable"/>
                <field name="last_read_at"/>
            </list>
        </field>
    </record>
    <record id="weighbridge_scale_form" model="ir.ui.view">
        <field name="name">ddfsc.weighbridge.scale.form</field>
        <field name="model">ddfsc.weighbridge.scale</field>
        <field name="arch" type="xml">
            <form string="Weighbridge Scale">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="model"/>
                            <field name="max_age_seconds"/>
                            <field name="min_weight"/>
                            <field name="active"/>
                        </group>
                        <group string="Live Reading">
                            <field name="is_online" widget="boolean_toggle" readonly="1"/>
                            <field name="last_weight"/>
                            <field name="last_stable"/>
                            <field name="last_read_at"/>
                            <field name="last_dsd"/>
                            <field name="last_raw"/>
                        </group>
                    </group>
                    <p class="text-muted">Readings come from the scale bridge program on the weighbridge PC
                        (ddfsc_weighbridge/tools/scale_bridge.py), see ddfsc_weighbridge/docs/SCALE_INTEGRATION.md.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ddfsc_weighbridge_scale" model="ir.actions.act_window">
        <field name="name">Scales</field>
        <field name="res_model">ddfsc.weighbridge.scale</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
