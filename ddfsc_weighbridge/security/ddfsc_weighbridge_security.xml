<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ddfsc_weighbridge" model="ir.module.category">
        <field name="name">DDFSC Weighbridge</field>
        <field name="sequence">35</field>
    </record>
    <record id="privilege_ddfsc_weighbridge" model="res.groups.privilege">
        <field name="name">DDFSC Weighbridge</field>
        <field name="category_id" ref="module_category_ddfsc_weighbridge"/>
        <field name="sequence">35</field>
    </record>
    <record id="group_ddfsc_weighbridge_user" model="res.groups">
        <field name="name">Operator</field>
        <field name="privilege_id" ref="privilege_ddfsc_weighbridge"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user')), (4, ref('purchase.group_purchase_user'))]"/>
    </record>
    <record id="group_ddfsc_weighbridge_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_ddfsc_weighbridge"/>
        <field name="implied_ids" eval="[(4, ref('group_ddfsc_weighbridge_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
