<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_device_company" model="ir.rule">
        <field name="name">Biometric devices by company</field>
        <field name="model_id" ref="model_ddfsc_biometric_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_punch_company" model="ir.rule">
