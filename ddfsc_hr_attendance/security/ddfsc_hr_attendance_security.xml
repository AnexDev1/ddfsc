        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_shift_assignment_company" model="ir.rule">
        <field name="name">Schedule assignments by company</field>
        <field name="model_id" ref="model_ddfsc_shift_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_attendance_correction_company" model="ir.rule">
        <field name="name">Attendance corrections by company</field>
        <field name="model_id" ref="model_ddfsc_attendance_correction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
