<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shift_assignment_list" model="ir.ui.view">
        <field name="name">ddfsc.shift.assignment.list</field>
        <field name="model">ddfsc.shift.assignment</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="calendar_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="late_grace_minutes" optional="show"/>
                <field name="early_departure_grace_minutes" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_shift_assignment_form" model="ir.ui.view">
        <field name="name">ddfsc.shift.assignment.form</field>
        <field name="model">ddfsc.shift.assignment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="employee_id"/></h1></div>
                    <group>
                        <group>
                            <field name="calendar_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group string="Attendance Tolerances">
                        <field name="late_grace_minutes"/>
                        <field name="early_departure_grace_minutes"/>
                    </group>
                    <group string="Notes"><field name="notes" nolabel="1"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_shift_assignments" model="ir.actions.act_window">
        <field name="name">Schedule Assignments</field>
        <field name="res_model">ddfsc.shift.assignment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
