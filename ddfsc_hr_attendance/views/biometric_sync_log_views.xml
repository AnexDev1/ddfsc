<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_biometric_sync_log_list" model="ir.ui.view">
        <field name="name">ddfsc.biometric.sync.log.list</field>
        <field name="model">ddfsc.biometric.sync.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="status == 'failed'">
                <field name="started_at"/>
                <field name="device_id"/>
                <field name="trigger"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'" decoration-warning="status == 'running'"/>
                <field name="imported_count"/>
                <field name="duplicate_count"/>
                <field name="finished_at" optional="show"/>
                <field name="error_message" optional="show"/>
            </list>
        </field>
    </record>
    <record id="action_biometric_sync_logs" model="ir.actions.act_window">
        <field name="name">Synchronization History</field>
        <field name="res_model">ddfsc.biometric.sync.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
