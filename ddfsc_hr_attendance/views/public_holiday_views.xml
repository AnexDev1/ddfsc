<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="public_holiday_list" model="ir.ui.view">
        <field name="name">ddfsc.public.holiday.list</field>
        <field name="model">ddfsc.public.holiday</field>
        <field name="arch" type="xml"><list><field name="date"/><field name="name"/><field name="non_working"/><field name="company_id" groups="base.group_multi_company"/><field name="active" optional="hide"/></list></field>
    </record>
    <record id="public_holiday_form" model="ir.ui.view">
        <field name="name">ddfsc.public.holiday.form</field>
        <field name="model">ddfsc.public.holiday</field>
        <field name="arch" type="xml"><form string="Public Holiday"><sheet><group><field name="name"/><field name="date"/><field name="non_working"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group><field name="note" placeholder="Official holiday reference or factory closure note..."/></sheet></form></field>
    </record>
    <record id="public_holiday_action" model="ir.actions.act_window">
        <field name="name">Public Holidays</field><field name="res_model">ddfsc.public.holiday</field><field name="view_mode">list,form</field>
    </record>
</odoo>
