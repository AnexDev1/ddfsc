<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_biometric_punch_search" model="ir.ui.view">
        <field name="name">ddfsc.biometric.punch.search</field>
        <field name="model">ddfsc.biometric.punch</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="device_user_id"/>
                <field name="device_id"/>
                <filter name="needs_review" string="Needs Review" domain="[('state', 'in', ('unmapped', 'error'))]"/>
                <filter name="ready" string="Ready to Process" domain="[('state', '=', 'new')]"/>
                <filter name="processed" string="Processed" domain="[('state', '=', 'processed')]"/>
                <separator/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_device" string="Device" context="{'group_by': 'device_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_day" string="Day" context="{'group_by': 'event_time:day'}"/>
            </search>
        </field>
    </record>
    <record id="view_biometric_punch_list" model="ir.ui.view">
        <field name="name">ddfsc.biometric.punch.list</field>
        <field name="model">ddfsc.biometric.punch</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-danger="state in ('unmapped', 'error')" decoration-muted="state == 'ignored'">
                <header>
                    <button name="action_process" string="Process Selected" type="object" class="btn-primary"/>
                    <button name="action_retry_mapping" string="Retry Employee Mapping" type="object"/>
                    <button name="action_ignore" string="Ignore" type="object"/>
                </header>
                <field name="event_time"/>
                <field name="device_user_id"/>
                <field name="employee_id"/>
                <field name="punch_type"/>
                <field name="device_id" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'processed'" decoration-warning="state == 'new'" decoration-danger="state in ('unmapped', 'error')"/>
                <field name="error_message" optional="show"/>
                <field name="attendance_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_biometric_punch_form" model="ir.ui.view">
        <field name="name">ddfsc.biometric.punch.form</field>
        <field name="model">ddfsc.biometric.punch</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button name="action_process" string="Process Punch" type="object" class="btn-primary" invisible="state not in ('new', 'error')"/>
                    <button name="action_retry_mapping" string="Retry Employee Mapping" type="object" class="btn-primary" invisible="state != 'unmapped'"/>
                    <button name="action_ignore" string="Ignore" type="object" invisible="state in ('processed', 'ignored')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,processed,unmapped,error,ignored"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="employee_id"/></h1></div>
                    <group>
                        <group>
                            <field name="event_time"/>
                            <field name="punch_type"/>
                            <field name="device_user_id"/>
                            <field name="device_id"/>
                        </group>
                        <group>
                            <field name="attendance_id"/>
                            <field name="imported_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="alert alert-danger" role="alert" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </div>
                    <group string="Original Device Payload"><field name="raw_payload" nolabel="1"/></group>
                    <field name="event_key" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_biometric_punches" model="ir.actions.act_window">
        <field name="name">Raw Punches</field>
        <field name="res_model">ddfsc.biometric.punch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_biometric_punch_search"/>
        <field name="context">{'search_default_needs_review': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No biometric punches need review.</p><p>Import device punches, map employee IDs, then process them into attendance.</p></field>
    </record>
</odoo>
