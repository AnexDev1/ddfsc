<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_period_list" model="ir.ui.view"><field name="name">ddfsc.attendance.period.list</field><field name="model">ddfsc.attendance.period</field><field name="arch" type="xml"><list decoration-success="state == 'locked'" decoration-info="state == 'validated'" decoration-warning="state == 'reopened'"><field name="name"/><field name="date_from"/><field name="date_to"/><field name="open_exception_count"/><field name="pending_overtime_count"/><field name="state" widget="badge" decoration-success="state == 'locked'" decoration-info="state == 'validated'" decoration-warning="state == 'reopened'"/></list></field></record>
    <record id="view_attendance_period_form" model="ir.ui.view"><field name="name">ddfsc.attendance.period.form</field><field name="model">ddfsc.attendance.period</field><field name="arch" type="xml"><form><header><button name="action_validate" string="Validate Attendance" type="object" class="btn-primary" groups="hr_attendance.group_hr_attendance_manager" invisible="state not in ('draft', 'reopened')"/><button name="action_lock" string="Lock for Payroll" type="object" class="btn-primary" groups="hr_attendance.group_hr_attendance_manager" invisible="state != 'validated'"/><button name="action_reopen" string="Controlled Reopen" type="object" groups="hr_attendance.group_hr_attendance_manager" invisible="state != 'locked'"/><field name="state" widget="statusbar" statusbar_visible="draft,validated,locked,reopened"/></header><sheet><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group><field name="date_from" readonly="state != 'draft'"/><field name="date_to" readonly="state != 'draft'"/><field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/></group><group string="Review Status"><field name="attendance_count"/><field name="open_exception_count"/><field name="pending_overtime_count"/></group></group><div class="alert alert-warning" role="alert" invisible="not open_exception_count">Open attendance exceptions must be resolved or ignored before validation.</div><div class="alert alert-warning" role="alert" invisible="not pending_overtime_count">Pending overtime reviews must be approved or rejected before validation.</div><group string="Validation" invisible="state == 'draft'"><field name="validated_by"/><field name="validated_at"/><field name="locked_by"/><field name="locked_at"/></group><group string="Controlled Reopening" invisible="state != 'locked' and state != 'reopened'"><field name="reopen_reason" readonly="state == 'reopened'" placeholder="Why must this finalized attendance period be reopened?"/><field name="reopened_by"/><field name="reopened_at"/></group></sheet><chatter/></form></field></record>
    <record id="action_attendance_periods" model="ir.actions.act_window"><field name="name">Attendance Periods</field><field name="res_model">ddfsc.attendance.period</field><field name="view_mode">list,form</field></record>
</odoo>
