<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_overtime_policy_list" model="ir.ui.view"><field name="name">ddfsc.overtime.policy.list</field><field name="model">ddfsc.overtime.policy</field><field name="arch" type="xml"><list><field name="name"/><field name="date_from"/><field name="date_to"/><field name="minimum_minutes"/><field name="include_non_working_days"/><field name="active"/></list></field></record>
    <record id="view_overtime_policy_form" model="ir.ui.view"><field name="name">ddfsc.overtime.policy.form</field><field name="model">ddfsc.overtime.policy</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="date_from"/><field name="date_to"/><field name="active"/></group><group><field name="minimum_minutes"/><field name="include_non_working_days"/><field name="company_id" groups="base.group_multi_company"/></group></group><group string="Policy Notes"><field name="note" nolabel="1" placeholder="Describe the approved attendance eligibility policy..."/></group></sheet></form></field></record>
    <record id="action_overtime_policies" model="ir.actions.act_window"><field name="name">Overtime Policies</field><field name="res_model">ddfsc.overtime.policy</field><field name="view_mode">list,form</field></record>
    <record id="view_overtime_request_list" model="ir.ui.view"><field name="name">ddfsc.overtime.request.list</field><field name="model">ddfsc.overtime.request</field><field name="arch" type="xml"><list create="0" delete="0" decoration-success="state == 'approved'" decoration-warning="state == 'submitted'"><header><button name="action_generate_yesterday" string="Generate Yesterday's Candidates" type="object" class="btn-primary"/></header><field name="work_date"/><field name="employee_id"/><field name="eligible_hours"/><field name="approved_hours"/><field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'submitted'"/></list></field></record>
    <record id="view_overtime_request_form" model="ir.ui.view"><field name="name">ddfsc.overtime.request.form</field><field name="model">ddfsc.overtime.request</field><field name="arch" type="xml"><form create="0" delete="0"><header><button name="action_submit" string="Submit for Approval" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_approve" string="Approve Hours" type="object" class="btn-primary" groups="hr_attendance.group_hr_attendance_manager" invisible="state != 'submitted'"/><button name="action_reject" string="Reject" type="object" groups="hr_attendance.group_hr_attendance_manager" invisible="state != 'submitted'"/><button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state not in ('submitted', 'rejected')"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group string="Eligibility"><field name="employee_id"/><field name="work_date"/><field name="policy_id"/><field name="eligible_hours"/></group><group string="Approval"><field name="approved_hours" readonly="state not in ('draft', 'submitted')"/><field name="reviewed_by"/><field name="reviewed_at"/><field name="review_note" readonly="state == 'approved'"/></group></group><group string="Attendance Evidence"><field name="scheduled_start"/><field name="scheduled_end"/><field name="first_check_in"/><field name="last_check_out"/><field name="attendance_ids" widget="many2many_tags"/></group><field name="company_id" invisible="1"/></sheet><chatter/></form></field></record>
    <record id="action_overtime_requests" model="ir.actions.act_window"><field name="name">Overtime Review</field><field name="res_model">ddfsc.overtime.request</field><field name="view_mode">list,form</field><field name="context">{'search_default_pending': 1}</field></record>
</odoo>
