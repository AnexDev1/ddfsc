<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_biometric" model="ir.ui.view">
        <field name="name">hr.employee.form.biometric</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="employee_number" required="1"/>
                <field name="biometric_user_id" groups="hr_attendance.group_hr_attendance_user"/>
            </xpath>
            <xpath expr="//field[@name='resource_calendar_id']" position="after">
                <field name="payroll_eligible"/>
                <field name="shift_assignment_ids" readonly="1">
                    <list>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="calendar_id"/>
                        <field name="late_grace_minutes"/>
                        <field name="early_departure_grace_minutes"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
