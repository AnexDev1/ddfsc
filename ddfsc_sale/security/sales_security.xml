<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="category_ddfsc_sales" model="ir.module.category">
            <field name="name">Sales</field>
            <field name="description">Sales initiation, approval, and invoicing responsibilities.</field>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_sales_initiator" model="res.groups.privilege">
            <field name="name">Sales: Initiator</field>
            <field name="category_id" ref="category_ddfsc_sales"/>
            <field name="sequence">10</field>
        </record>
        <record id="privilege_sales_approver" model="res.groups.privilege">
            <field name="name">Sales: Approver</field>
            <field name="category_id" ref="category_ddfsc_sales"/>
            <field name="sequence">20</field>
        </record>
        <record id="privilege_sales_invoicer" model="res.groups.privilege">
            <field name="name">Sales: Invoicer</field>
            <field name="category_id" ref="category_ddfsc_sales"/>
            <field name="sequence">30</field>
        </record>

        <record id="group_sales_initiator" model="res.groups">
            <field name="name">Allowed</field>
            <field name="privilege_id" ref="privilege_sales_initiator"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="sequence">1</field>
        </record>
        <record id="group_sales_approver" model="res.groups">
            <field name="name">Allowed</field>
            <field name="privilege_id" ref="privilege_sales_approver"/>
            <field name="implied_ids" eval="[(4, ref('group_sales_initiator'))]"/>
            <field name="sequence">1</field>
        </record>
        <record id="group_sales_invoicer" model="res.groups">
            <field name="name">Allowed</field>
            <field name="privilege_id" ref="privilege_sales_invoicer"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('account.group_account_invoice'))]"/>
            <field name="sequence">1</field>
        </record>

        <record id="rule_sales_approver_pending_orders" model="ir.rule">
            <field name="name">Sales Approver: pending orders</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('state', 'in', ('to_approve', 'to_approve_discount'))]</field>
            <field name="groups" eval="[(4, ref('group_sales_approver'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_sales_invoicer_invoice_orders" model="ir.rule">
            <field name="name">Sales Invoicer: confirmed invoice orders</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('state', 'in', ('sale', 'done')), ('invoice_status', 'in', ('to invoice', 'upselling', 'invoiced'))]</field>
            <field name="groups" eval="[(4, ref('group_sales_invoicer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
