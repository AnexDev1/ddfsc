<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nonconformance_list" model="ir.ui.view">
        <field name="name">ddfsc.quality.nonconformance.list</field>
        <field name="model">ddfsc.quality.nonconformance</field>
        <field name="arch" type="xml">
            <list decoration-danger="severity == 'critical' or state == 'action'" decoration-warning="state in ('new', 'investigation')">
                <field name="name"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="severity" widget="badge"/>
                <field name="affected_qty"/>
                <field name="owner_id"/>
                <field name="due_date"/>
                <field name="disposition"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="nonconformance_pivot" model="ir.ui.view">
        <field name="name">ddfsc.quality.nonconformance.pivot</field>
        <field name="model">ddfsc.quality.nonconformance</field>
        <field name="arch" type="xml">
            <pivot string="Quality Failure Analysis">
                <field name="product_id" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="severity" type="col"/>
                <field name="affected_qty" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="nonconformance_graph" model="ir.ui.view">
        <field name="name">ddfsc.quality.nonconformance.graph</field>
        <field name="model">ddfsc.quality.nonconformance</field>
        <field name="arch" type="xml">
            <graph string="Non-Conformance Trend" type="bar">
                <field name="create_date" interval="month"/>
                <field name="severity"/>
            </graph>
        </field>
    </record>
    <record id="nonconformance_form" model="ir.ui.view">
        <field name="name">ddfsc.quality.nonconformance.form</field>
        <field name="model">ddfsc.quality.nonconformance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_investigate" type="object" string="Start Investigation" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_require_action" type="object" string="Require Action" class="btn-primary" invisible="state != 'investigation'"/>
                    <button name="action_verify" type="object" string="Send for Verification" class="btn-primary" invisible="state != 'action'"/>
                    <button name="action_close" type="object" string="Close" class="btn-primary" invisible="state != 'verification'" groups="ddfsc_quality.group_ddfsc_quality_manager"/>
                    <button name="action_reinspect" type="object" string="Start Reinspection" invisible="disposition != 'retest' or state == 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,investigation,action,verification,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="lot_id" readonly="state != 'new'"/>
                            <field name="inspection_id" readonly="1"/>
                            <field name="product_id"/>
                            <field name="affected_qty" readonly="state == 'closed'"/>
                            <field name="severity" readonly="state == 'closed'"/>
                            <field name="owner_id" readonly="state == 'closed'"/>
                            <field name="due_date" readonly="state == 'closed'"/>
                        </group>
                        <group>
                            <field name="picking_id"/>
                            <field name="production_id"/>
                            <field name="partner_id"/>
                            <field name="disposition"/>
                            <field name="closed_by_id" invisible="not closed_by_id"/>
                            <field name="closed_date" invisible="not closed_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Failure"><field name="defect_description" placeholder="Describe the failed requirement and observed defect..."/></page>
                        <page string="Investigation and Action">
                            <group><field name="root_cause"/><field name="corrective_action"/><field name="preventive_action"/></group>
                        </page>
                        <page string="Verification and Closure">
                            <group><field name="verification"/><field name="closure_note"/></group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="nonconformance_search" model="ir.ui.view">
        <field name="name">ddfsc.quality.nonconformance.search</field>
        <field name="model">ddfsc.quality.nonconformance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="lot_id"/><field name="product_id"/><field name="owner_id"/>
                <filter name="open" string="Open" domain="[('state', 'not in', ('closed', 'canceled'))]"/>
                <filter name="critical" string="Critical" domain="[('severity', '=', 'critical')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                <filter name="group_supplier" string="Supplier" context="{'group_by': 'partner_id'}"/>
                <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
            </search>
        </field>
    </record>
    <record id="action_nonconformance" model="ir.actions.act_window">
        <field name="name">Non-Conformances</field>
        <field name="res_model">ddfsc.quality.nonconformance</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="nonconformance_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>
    <menuitem id="menu_nonconformance" name="Non-Conformances" parent="menu_ddfsc_qc_operations"
              action="action_nonconformance" sequence="15" groups="ddfsc_quality.group_ddfsc_quality_user"/>
</odoo>
