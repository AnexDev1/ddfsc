<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="qc_inspection_document_list" model="ir.ui.view">
        <field name="name">ddfsc.qc.inspection.list</field>
        <field name="model">ddfsc.qc.inspection</field>
        <field name="arch" type="xml">
            <list decoration-warning="state in ('draft', 'submitted')" decoration-danger="state == 'rejected'" decoration-success="state == 'approved'">
                <field name="name"/>
                <field name="lot_id" string="Lot / Batch"/>
                <field name="product_id"/>
                <field name="checkpoint"/>
                <field name="result_state" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="inspector_id"/>
                <field name="submitted_date"/>
            </list>
        </field>
    </record>
    <record id="qc_inspection_document_form" model="ir.ui.view">
        <field name="name">ddfsc.qc.inspection.form</field>
        <field name="model">ddfsc.qc.inspection</field>
        <field name="arch" type="xml">
            <form string="QC Inspection">
                <header>
                    <button name="action_submit" type="object" string="Submit for QC Approval" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_review" type="object" string="Approve / Reject Results" class="btn-primary" invisible="state != 'submitted'" groups="ddfsc_quality.group_ddfsc_quality_manager"/>
                    <button name="action_start_reinspection" type="object" string="Start Reinspection" invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="lot_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="plan_id" readonly="1"/>
                            <field name="checkpoint" readonly="1"/>
                        </group>
                        <group>
                            <field name="receipt_id" readonly="1"/>
                            <field name="production_id" readonly="1"/>
                            <field name="supplier_id" readonly="1"/>
                            <field name="result_state" widget="badge" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">Enter only the measured laboratory result or observed result. Limits and permitted answers are copied from the approved Acceptance Plan.</div>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" widget="handle" readonly="1"/>
                            <field name="name" string="Test" readonly="1"/>
                            <field name="specification" readonly="1"/>
                            <field name="measured_value" invisible="result_type == 'qualitative'"/>
                            <field name="measured_text" string="Observed Result" invisible="result_type != 'qualitative'"/>
                            <field name="is_measured"/>
                            <field name="result" widget="badge" readonly="1"/>
                            <field name="note" readonly="1"/>
                        </list>
                    </field>
                    <group invisible="state != 'rejected'"><field name="reinspection_reason" placeholder="Explain why a new sample or reinspection is justified..."/></group>
                    <notebook>
                        <page string="Approval Audit"><group><field name="inspector_id" readonly="1"/><field name="submitted_by_id" readonly="1"/><field name="submitted_date" readonly="1"/><field name="reviewed_by_id" readonly="1"/><field name="reviewed_date" readonly="1"/></group></page>
                        <page string="Non-Conformances"><field name="nonconformance_ids" readonly="1"><list><field name="name"/><field name="severity"/><field name="owner_id"/><field name="state" widget="badge"/></list></field></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="qc_inspection_document_search" model="ir.ui.view">
        <field name="name">ddfsc.qc.inspection.search</field><field name="model">ddfsc.qc.inspection</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="lot_id"/><field name="product_id"/>
            <filter name="data_entry" string="Data Entry" domain="[('state','=','draft')]"/><filter name="awaiting" string="Awaiting Review" domain="[('state','=','submitted')]"/><filter name="approved" string="Approved" domain="[('state','=','approved')]"/><filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/>
            <group><filter name="group_checkpoint" string="Checkpoint" context="{'group_by':'checkpoint'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/></group>
        </search></field>
    </record>
    <record id="action_qc_inspection_document" model="ir.actions.act_window">
        <field name="name">QC Inspections</field><field name="res_model">ddfsc.qc.inspection</field><field name="view_mode">list,form</field><field name="search_view_id" ref="qc_inspection_document_search"/>
    </record>
</odoo>
