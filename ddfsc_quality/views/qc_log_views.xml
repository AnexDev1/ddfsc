<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="qc_log_template_list" model="ir.ui.view">
        <field name="name">ddfsc.qc.log.template.list</field>
        <field name="model">ddfsc.qc.log.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="form_no"/>
                <field name="name"/>
                <field name="frequency"/>
                <field name="area"/>
            </list>
        </field>
    </record>
    <record id="qc_log_template_form" model="ir.ui.view">
        <field name="name">ddfsc.qc.log.template.form</field>
        <field name="model">ddfsc.qc.log.template</field>
        <field name="arch" type="xml">
            <form string="Log Sheet Template">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="form_no"/><field name="frequency"/></group>
                        <group><field name="area"/><field name="active"/></group>
                    </group>
                    <field name="instruction" placeholder="Instruction printed on the form..."/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="subject"/>
                            <field name="result_type"/>
                            <field name="apply_min" invisible="result_type == 'qualitative'"/>
                            <field name="standard_min" invisible="result_type == 'qualitative' or not apply_min"/>
                            <field name="apply_max" invisible="result_type == 'qualitative'"/>
                            <field name="standard_max" invisible="result_type == 'qualitative' or not apply_max"/>
                            <field name="unit"/>
                            <field name="allowed_answers" invisible="result_type != 'qualitative'"/>
                            <field name="specification" readonly="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_qc_log_template" model="ir.actions.act_window">
        <field name="name">Log Sheet Templates</field>
        <field name="res_model">ddfsc.qc.log.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="qc_log_list" model="ir.ui.view">
        <field name="name">ddfsc.qc.log.list</field>
        <field name="model">ddfsc.qc.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="result_state == 'fail'" decoration-muted="state == 'checked'">
                <field name="name"/>
                <field name="date"/>
                <field name="shift_id"/>
                <field name="form_no"/>
                <field name="template_id"/>
                <field name="out_of_standard_count" string="Out"/>
                <field name="result_state" widget="badge"
                       decoration-success="result_state == 'pass'" decoration-danger="result_state == 'fail'"/>
                <field name="state" widget="badge"/>
                <field name="recorded_by_id" optional="hide"/>
                <field name="checked_by_id" optional="show"/>
            </list>
        </field>
    </record>
    <record id="qc_log_form" model="ir.ui.view">
        <field name="name">ddfsc.qc.log.form</field>
        <field name="model">ddfsc.qc.log</field>
        <field name="arch" type="xml">
            <form string="QC Log Sheet">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_check" type="object" string="Checked" class="btn-primary" invisible="state != 'submitted'"
                            groups="ddfsc_quality.group_ddfsc_quality_manager"/>
                    <button name="action_reopen" type="object" string="Send Back" invisible="state == 'draft'"
                            groups="ddfsc_quality.group_ddfsc_quality_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="template_id" readonly="id"/>
                            <field name="form_no"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="shift_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="result_state" widget="badge"
                                   decoration-success="result_state == 'pass'" decoration-danger="result_state == 'fail'"/>
                            <field name="out_of_standard_count"/>
                            <field name="recorded_by_id"/>
                            <field name="checked_by_id"/>
                            <field name="checked_date"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom" create="0" delete="0"
                              decoration-danger="result == 'fail'" decoration-success="result == 'pass'">
                            <field name="sequence" column_invisible="1"/>
                            <field name="subject"/>
                            <field name="specification"/>
                            <field name="result_type" column_invisible="1"/>
                            <field name="value" invisible="result_type == 'qualitative'"/>
                            <field name="text_value" invisible="result_type != 'qualitative'"/>
                            <field name="is_measured"/>
                            <field name="result" widget="badge"/>
                        </list>
                    </field>
                    <field name="remark" placeholder="Remark / action taken when a result is out of standard..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="qc_log_search" model="ir.ui.view">
        <field name="name">ddfsc.qc.log.search</field>
        <field name="model">ddfsc.qc.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="template_id"/>
                <field name="form_no"/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="recording" string="Recording" domain="[('state', '=', 'draft')]"/>
                <filter name="awaiting" string="Awaiting Check" domain="[('state', '=', 'submitted')]"/>
                <filter name="out" string="Out of Standard" domain="[('result_state', '=', 'fail')]"/>
                <group>
                    <filter name="group_template" string="Log Sheet" context="{'group_by': 'template_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_qc_log" model="ir.actions.act_window">
        <field name="name">QC Log Sheets</field>
        <field name="res_model">ddfsc.qc.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record today's shift checks</p>
            <p>Dryer moisture, magnetic separator, calibration, water, wheat at transfer, granulation and wheat in the warehouse.</p>
        </field>
    </record>

    <menuitem id="menu_ddfsc_qc_logs" name="QC Log Sheets" parent="menu_ddfsc_qc_operations"
              action="action_qc_log" sequence="15" groups="ddfsc_quality.group_ddfsc_quality_user"/>
    <menuitem id="menu_ddfsc_qc_log_templates" name="Log Sheet Templates" parent="menu_ddfsc_qc_standards"
              action="action_qc_log_template" sequence="20" groups="ddfsc_quality.group_ddfsc_quality_manager"/>
</odoo>
