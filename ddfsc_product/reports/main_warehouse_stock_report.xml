<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action for Main Warehouse Stock -->
    <record id="action_report_main_warehouse_stock" model="ir.actions.report">
        <field name="name">Main Warehouse Stock Sheet</field>
        <field name="model">main.warehouse.stock</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ddfsc_product.report_main_warehouse_stock_template</field>
        <field name="report_file">ddfsc_product.report_main_warehouse_stock_template</field>
        <field name="print_report_name">'Main Warehouse Stock - %s' % (time.strftime('%Y-%m-%d'))</field>
        <field name="binding_model_id" ref="model_main_warehouse_stock"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template for Main Warehouse Stock Sheet -->
    <template id="report_main_warehouse_stock_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-size: 12px; color: #333;">
                    <!-- Document Header Title -->
                    <div class="row pb-2 mb-3 border-bottom border-2 border-dark align-items-center">
                        <div class="col-7">
                            <h3 class="fw-bold m-0" style="color: #1d3557; text-transform: uppercase;">
                                Main Warehouse Stock Sheet
                            </h3>
                            <div class="text-muted small mt-1">Official Inventory Status &amp; Rack Location Report</div>
                        </div>
                        <div class="col-5 text-end">
                            <div class="fw-bold fs-6 text-primary">
                                <t t-if="docs and docs[0].warehouse_id">
                                    <t t-esc="docs[0].warehouse_id.name"/> (<t t-esc="docs[0].warehouse_id.code"/>)
                                </t>
                                <t t-else="">
                                    Main Central Warehouse
                                </t>
                            </div>
                            <div class="text-muted small">Report Generated: <span t-esc="time.strftime('%Y-%m-%d %H:%M')"/></div>
                        </div>
                    </div>

                    <!-- KPI Summary Cards -->
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <div class="p-2 border rounded bg-light text-center">
                                <div class="text-muted small text-uppercase fw-bold">Total Distinct Items</div>
                                <div class="fs-5 fw-bold text-dark mt-1">
                                    <t t-esc="len(docs)"/> Products
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded bg-light text-center">
                                <div class="text-muted small text-uppercase fw-bold">Total Units In Stock</div>
                                <div class="fs-5 fw-bold text-primary mt-1">
                                    <t t-esc="'%.2f' % sum(d.quantity for d in docs)"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded bg-light text-center">
                                <div class="text-muted small text-uppercase fw-bold">Net Available to Use</div>
                                <div class="fs-5 fw-bold text-success mt-1">
                                    <t t-esc="'%.2f' % sum(d.available_quantity for d in docs)"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Stock Inventory Table -->
                    <table class="table table-sm table-bordered align-middle" style="font-size: 11px;">
                        <thead class="table-dark text-white text-center">
                            <tr>
                                <th style="width: 4%;">#</th>
                                <th style="width: 6%;">Image</th>
                                <th style="width: 14%;">Code</th>
                                <th>Product Name</th>
                                <th style="width: 14%;">Location / Rack</th>
                                <th style="width: 11%;">On Hand</th>
                                <th style="width: 10%;">Reserved</th>
                                <th style="width: 11%;">Available</th>
                                <th style="width: 8%;">UoM</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="total_on_hand" t-value="0.0"/>
                            <t t-set="total_reserved" t-value="0.0"/>
                            <t t-set="total_available" t-value="0.0"/>
                            <t t-foreach="docs" t-as="doc">
                                <t t-set="total_on_hand" t-value="total_on_hand + doc.quantity"/>
                                <t t-set="total_reserved" t-value="total_reserved + doc.reserved_quantity"/>
                                <t t-set="total_available" t-value="total_available + doc.available_quantity"/>
                                <tr>
                                    <td class="text-center fw-bold text-muted"><t t-esc="doc_index + 1"/></td>
                                    <td class="text-center p-1">
                                        <t t-if="doc.image_128">
                                            <img t-att-src="image_data_uri(doc.image_128)" style="max-height: 32px; max-width: 32px; object-fit: contain; border-radius: 4px; border: 1px solid #ddd;"/>
                                        </t>
                                        <t t-else="">
                                            <span class="text-muted small">-</span>
                                        </t>
                                    </td>
                                    <td class="fw-bold text-primary"><t t-esc="doc.default_code or '-'"/></td>
                                    <td>
                                        <span class="fw-bold"><t t-esc="doc.product_id.name"/></span>
                                        <div t-if="doc.categ_id" class="text-muted small" style="font-size: 10px;">
                                            <t t-esc="doc.categ_id.complete_name"/>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border p-1" style="font-size: 10px;">
                                            <t t-esc="doc.location_id.name or '-'"/>
                                        </span>
                                    </td>
                                    <td class="text-end fw-bold fs-6"><t t-esc="'%.2f' % doc.quantity"/></td>
                                    <td class="text-end text-muted"><t t-esc="'%.2f' % doc.reserved_quantity"/></td>
                                    <td class="text-end fw-bold" t-attf-class="#{ 'text-success' if doc.available_quantity &gt; 0 else 'text-danger' }">
                                        <t t-esc="'%.2f' % doc.available_quantity"/>
                                    </td>
                                    <td class="text-center text-muted"><t t-esc="doc.uom_id.name"/></td>
                                </tr>
                            </t>
                            <tr class="table-secondary fw-bold">
                                <td colspan="5" class="text-end">Grand Totals:</td>
                                <td class="text-end text-dark fs-6"><t t-esc="'%.2f' % total_on_hand"/></td>
                                <td class="text-end text-muted fs-6"><t t-esc="'%.2f' % total_reserved"/></td>
                                <td class="text-end text-success fs-6"><t t-esc="'%.2f' % total_available"/></td>
                                <td class="text-center">Units</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Official Sign-off Block -->
                    <div class="mt-4 pt-3 border-top border-2" style="page-break-inside: avoid; font-size: 11px;">
                        <div class="row g-3 text-center">
                            <div class="col-6">
                                <div class="p-2 border rounded">
                                    <div class="fw-bold text-dark mb-1">Prepared / Audited By</div>
                                    <div class="text-muted" style="min-height: 18px;">
                                        <t t-esc="user.name"/>
                                    </div>
                                    <div class="border-bottom my-3" style="border-style: dashed !important;"/>
                                    <span class="text-muted small">Signature &amp; Date</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 border rounded">
                                    <div class="fw-bold text-dark mb-1">Warehouse Supervisor / Manager Approval</div>
                                    <div class="text-muted" style="min-height: 18px;">
                                        Authorized Signatory
                                    </div>
                                    <div class="border-bottom my-3" style="border-style: dashed !important;"/>
                                    <span class="text-muted small">Signature &amp; Date</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
