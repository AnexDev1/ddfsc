<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================== -->
    <!-- 1. Inventory > Reporting > Stock (product.product)        -->
    <!-- ======================================================== -->
    <record id="product_product_stock_tree_inherit_ddfsc" model="ir.ui.view">
        <field name="name">product.product.stock.list.inherit.ddfsc</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_product_stock_tree"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="before">
                <field name="image_1920"
                       string="Image"
                       widget="image"
                       options="{'zoom': true, 'preview_image': 'image_128', 'size': [40, 40]}"
                       width="45"
                       optional="show"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

