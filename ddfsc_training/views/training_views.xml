<odoo>
 <record id="training_request_action" model="ir.actions.act_window"><field name="name">Training Requests</field><field name="res_model">ddfsc.training.request</field><field name="view_mode">list,form</field></record>
 <record id="training_session_action" model="ir.actions.act_window"><field name="name">Training Sessions</field><field name="res_model">ddfsc.training.session</field><field name="view_mode">list,form</field></record>
 <record id="training_course_action" model="ir.actions.act_window"><field name="name">Training Courses</field><field name="res_model">ddfsc.training.course</field><field name="view_mode">list,form</field></record>
 <record id="training_request_form" model="ir.ui.view"><field name="name">ddfsc.training.request.form</field><field name="model">ddfsc.training.request</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/><button name="action_manager_approve" type="object" string="Manager Approve" invisible="state != 'manager'"/><button name="action_hr_approve" type="object" string="HR Approve" class="btn-primary" groups="hr.group_hr_manager" invisible="state != 'hr'"/><button name="action_reject" type="object" string="Reject" invisible="state not in ('manager','hr')"/><field name="state" widget="statusbar"/></header><sheet><group><field name="employee_id" readonly="state != 'draft'"/><field name="course_id" readonly="state != 'draft'"/><field name="request_date" readonly="state != 'draft'"/><field name="session_id" readonly="1"/></group><field name="justification" readonly="state != 'draft'"/><field name="expected_outcome" readonly="state != 'draft'"/></sheet><chatter/></form></field></record>
 <record id="training_session_form" model="ir.ui.view"><field name="name">ddfsc.training.session.form</field><field name="model">ddfsc.training.session</field><field name="arch" type="xml"><form><header><button name="action_schedule" type="object" string="Schedule" class="btn-primary" invisible="state != 'draft'"/><button name="action_complete" type="object" string="Complete" class="btn-primary" invisible="state != 'scheduled'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="course_id"/><field name="date_start"/><field name="date_end"/><field name="venue"/><field name="trainer"/><field name="capacity"/><field name="cost"/></group><field name="attendee_ids"><list editable="bottom"><field name="employee_id"/><field name="attendance_state"/><field name="assessment_score"/><field name="certificate_reference"/><field name="certificate_expiry"/></list></field></sheet><chatter/></form></field></record>
 <record id="training_course_form" model="ir.ui.view"><field name="name">ddfsc.training.course.form</field><field name="model">ddfsc.training.course</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="category"/><field name="provider"/><field name="duration_hours"/><field name="active"/></group><field name="description"/></sheet></form></field></record>
 <menuitem id="training_root" name="Training" parent="hr.menu_hr_root" sequence="46" groups="hr.group_hr_user"/><menuitem id="training_requests" name="Requests" parent="training_root" action="training_request_action" sequence="10" groups="hr.group_hr_user"/><menuitem id="training_sessions" name="Sessions" parent="training_root" action="training_session_action" sequence="20" groups="hr.group_hr_user"/><menuitem id="training_courses" name="Courses" parent="training_root" action="training_course_action" sequence="30" groups="hr.group_hr_manager"/>
</odoo>
