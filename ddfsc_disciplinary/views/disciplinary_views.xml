<odoo>
<record id="disciplinary_case_action" model="ir.actions.act_window"><field name="name">Disciplinary Cases</field><field name="res_model">ddfsc.disciplinary.case</field><field name="view_mode">list,form,pivot,graph</field></record>
<record id="disciplinary_type_action" model="ir.actions.act_window"><field name="name">Disciplinary Categories</field><field name="res_model">ddfsc.disciplinary.type</field><field name="view_mode">list,form</field></record>
<record id="disciplinary_case_form" model="ir.ui.view"><field name="name">ddfsc.disciplinary.case.form</field><field name="model">ddfsc.disciplinary.case</field><field name="arch" type="xml"><form delete="0"><header><button name="action_start_investigation" type="object" string="Start Investigation" class="btn-primary" groups="hr.group_hr_manager" invisible="state != 'draft'"/><button name="action_request_response" type="object" string="Request Employee Response" groups="hr.group_hr_manager" invisible="state != 'investigation'"/><button name="action_schedule_hearing" type="object" string="Schedule Hearing" groups="hr.group_hr_manager" invisible="state != 'response'"/><button name="action_submit_decision" type="object" string="Submit Decision" class="btn-primary" groups="hr.group_hr_manager" invisible="state != 'hearing'"/><button name="action_close" type="object" string="Close Case" class="btn-primary" groups="hr.group_hr_manager" invisible="state != 'approval'"/><field name="state" widget="statusbar"/></header><sheet><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group><field name="employee_id" readonly="state != 'draft'"/><field name="type_id" readonly="state != 'draft'"/><field name="incident_date" readonly="state != 'draft'"/><field name="reported_by" readonly="state != 'draft'"/></group><group><field name="investigator_id"/><field name="hearing_date"/><field name="action_type" readonly="state not in ('hearing','approval')"/></group></group><field name="description" readonly="state != 'draft'"/><notebook><page string="Investigation"><field name="findings" readonly="state not in ('investigation','response','hearing')"/></page><page string="Employee Response"><field name="employee_response" readonly="state not in ('response','hearing')"/></page><page string="Hearing &amp; Decision"><field name="hearing_outcome" readonly="state not in ('hearing','approval')"/><field name="action_note" readonly="state not in ('hearing','approval')"/></page></notebook></sheet><chatter/></form></field></record>
<menuitem id="disciplinary_root" name="Disciplinary" parent="hr.menu_hr_root" sequence="47" groups="hr.group_hr_manager"/><menuitem id="disciplinary_cases" name="Cases" parent="disciplinary_root" action="disciplinary_case_action" sequence="10" groups="hr.group_hr_manager"/><menuitem id="disciplinary_types" name="Categories" parent="disciplinary_root" action="disciplinary_type_action" sequence="20" groups="hr.group_hr_manager"/>
</odoo>
