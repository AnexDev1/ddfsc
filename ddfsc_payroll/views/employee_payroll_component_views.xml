<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_component_list" model="ir.ui.view">
        <field name="name">ddfsc.employee.payroll.component.list</field><field name="model">ddfsc.employee.payroll.component</field>
        <field name="arch" type="xml"><list decoration-success="state == 'approved'" decoration-muted="state == 'cancelled'">
            <field name="employee_id"/><field name="component_type_id"/><field name="component_kind" widget="badge"/>
            <field name="amount" sum="Total"/><field name="recurrence"/><field name="date_from"/><field name="date_to"/>
            <field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/>
        </list></field>
    </record>
    <record id="employee_component_form" model="ir.ui.view">
        <field name="name">ddfsc.employee.payroll.component.form</field><field name="model">ddfsc.employee.payroll.component</field>
        <field name="arch" type="xml"><form string="Employee Payroll Component">
            <header><button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'draft'"/>
                <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,approved,cancelled"/></header>
            <sheet><div class="oe_title"><h1><field name="component_type_id" readonly="state != 'draft'"/></h1></div>
                <group><group><field name="employee_id" readonly="state != 'draft'"/><field name="amount" readonly="state != 'draft'"/><field name="recurrence" readonly="state != 'draft'"/></group>
                <group><field name="date_from" readonly="state != 'draft'"/><field name="date_to" readonly="state != 'draft'"/><field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/></group></group>
                <field name="note" placeholder="Reason, approval reference, or payroll note..." readonly="state != 'draft'"/>
            </sheet><chatter/></form></field>
    </record>
    <record id="employee_component_search" model="ir.ui.view">
        <field name="name">ddfsc.employee.payroll.component.search</field><field name="model">ddfsc.employee.payroll.component</field>
        <field name="arch" type="xml"><search><field name="employee_id"/><field name="component_type_id"/>
            <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
            <filter name="recurring" string="Recurring" domain="[('recurrence','=','recurring')]"/>
            <filter name="one_off" string="One-time" domain="[('recurrence','=','one_off')]"/>
            <group><filter name="group_employee" string="Employee" context="{'group_by':'employee_id'}"/>
                <filter name="group_type" string="Component Type" context="{'group_by':'component_type_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by':'state'}"/></group>
        </search></field>
    </record>
    <record id="employee_component_action" model="ir.actions.act_window">
        <field name="name">Employee Components</field><field name="res_model">ddfsc.employee.payroll.component</field>
        <field name="view_mode">list,form</field><field name="search_view_id" ref="employee_component_search"/>
    </record>
</odoo>

