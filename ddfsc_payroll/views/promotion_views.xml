<?xml version="1.0" encoding="utf-8"?><odoo>
<record id="grade_action" model="ir.actions.act_window"><field name="name">Job Grades</field><field name="res_model">ddfsc.job.grade</field><field name="view_mode">list,form</field></record>
<record id="band_action" model="ir.actions.act_window"><field name="name">Salary Bands</field><field name="res_model">ddfsc.salary.band</field><field name="view_mode">list,form</field></record>
<record id="change_action" model="ir.actions.act_window"><field name="name">Promotion &amp; Compensation</field><field name="res_model">ddfsc.employee.change.request</field><field name="view_mode">list,form</field></record>
<record id="change_list" model="ir.ui.view"><field name="name">ddfsc.employee.change.request.list</field><field name="model">ddfsc.employee.change.request</field><field name="arch" type="xml"><list><field name="name"/><field name="request_type"/><field name="employee_id"/><field name="effective_date"/><field name="current_basic_salary"/><field name="proposed_basic_salary"/><field name="state" widget="badge"/></list></field></record>
<record id="change_form" model="ir.ui.view"><field name="name">ddfsc.employee.change.request.form</field><field name="model">ddfsc.employee.change.request</field><field name="arch" type="xml"><form delete="0"><header><button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state not in ('draft','rejected')"/><button name="action_manager_approve" type="object" string="Manager Approve" class="btn-primary" invisible="state != 'submitted'"/><button name="action_hr_approve" type="object" string="HR Approve" groups="hr.group_hr_manager" invisible="state != 'manager_approved'"/><button name="action_gm_approve" type="object" string="General Manager Approve" groups="ddfsc_manufacturing.group_ddfsc_gm" invisible="state != 'hr_approved'"/><button name="action_apply" type="object" string="Apply Effective Change" class="btn-primary" invisible="state != 'approved'"/><field name="state" widget="statusbar"/></header><sheet><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group><field name="request_type" readonly="state != 'draft'"/><field name="reason_type" readonly="state != 'draft'"/><field name="employee_id" readonly="state != 'draft'"/><field name="effective_date" readonly="state != 'draft'"/></group><group><field name="current_job_id"/><field name="current_department_id"/><field name="current_grade_id"/><field name="current_basic_salary"/></group></group><group string="Proposed Change"><group><field name="proposed_job_id" readonly="state != 'draft'"/><field name="proposed_department_id" readonly="state != 'draft'"/><field name="proposed_manager_id" readonly="state != 'draft'"/></group><group><field name="proposed_grade_id" readonly="state != 'draft'"/><field name="proposed_basic_salary" readonly="state != 'draft'"/></group></group><field name="justification" readonly="state != 'draft'"/><field name="rejection_reason" invisible="state != 'rejected'"/><field name="manager_note"/><field name="hr_note"/><field name="gm_note"/></sheet><chatter/></form></field></record>
<menuitem id="change_menu" name="Promotion &amp; Compensation" parent="payroll.payroll_menu_root" action="change_action" sequence="23" groups="payroll.group_payroll_user"/><menuitem id="grade_menu" name="Job Grades" parent="payroll.payroll_menu_configuration" action="grade_action" sequence="23" groups="hr.group_hr_manager"/><menuitem id="band_menu" name="Salary Bands" parent="payroll.payroll_menu_configuration" action="band_action" sequence="24" groups="hr.group_hr_manager"/>
</odoo>
