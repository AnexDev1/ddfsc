<?xml version="1.0" encoding="utf-8"?>
<odoo><record id="hr_payslip_form_component_source" model="ir.ui.view">
    <field name="name">hr.payslip.form.component.source</field><field name="model">hr.payslip</field><field name="inherit_id" ref="payroll.hr_payslip_view_form"/>
    <field name="arch" type="xml"><xpath expr="//field[@name='input_line_ids']/list/field[@name='amount']" position="after">
        <field name="component_ids" widget="many2many_tags" optional="show"/>
    </xpath>
    <xpath expr="//notebook" position="inside">
        <page string="DDFSC Payroll Summary" name="ddfsc_payroll_summary">
            <group string="Earnings">
                <field name="ddfsc_basic_pay" readonly="1"/>
                <field name="ddfsc_taxable_earnings" readonly="1" help="Basic pay plus taxable allowances and approved overtime."/>
                <field name="ddfsc_non_taxable_earnings" readonly="1"/>
            </group>
            <group string="Deductions &amp; Net Pay">
                <field name="ddfsc_income_tax" readonly="1"/>
                <field name="ddfsc_employee_pension" readonly="1"/>
                <field name="ddfsc_total_deductions" readonly="1"/>
                <field name="ddfsc_net_pay" readonly="1" class="fw-bold"/>
            </group>
            <group string="Employer Cost">
                <field name="ddfsc_employer_pension" readonly="1"/>
            </group>
            <div class="text-muted">This is a read-only summary of the detailed payslip computation. Recompute the draft payslip after changing approved inputs.</div>
        </page>
    </xpath></field>
</record></odoo>

