<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="component_type_list" model="ir.ui.view">
        <field name="name">ddfsc.payroll.component.type.list</field>
        <field name="model">ddfsc.payroll.component.type</field>
        <field name="arch" type="xml"><list decoration-muted="not active">
            <field name="name"/><field name="code"/><field name="component_kind" widget="badge"/>
            <field name="salary_rule_id"/><field name="taxable"/><field name="pensionable"/>
            <field name="company_id" groups="base.group_multi_company"/><field name="active" optional="hide"/>
        </list></field>
    </record>
    <record id="component_type_form" model="ir.ui.view">
        <field name="name">ddfsc.payroll.component.type.form</field><field name="model">ddfsc.payroll.component.type</field>
        <field name="arch" type="xml"><form string="Payroll Component Type"><sheet>
            <div class="oe_title"><h1><field name="name" placeholder="e.g. Transport Allowance"/></h1></div>
            <group><group><field name="code" placeholder="TRANSPORT"/><field name="component_kind"/><field name="salary_rule_id"/></group>
            <group><field name="taxable"/><field name="pensionable"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group></group>
            <field name="note" placeholder="Configuration notes and policy references..."/>
        </sheet></form></field>
    </record>
    <record id="component_type_action" model="ir.actions.act_window">
        <field name="name">Component Types</field><field name="res_model">ddfsc.payroll.component.type</field><field name="view_mode">list,form</field>
    </record>
</odoo>

