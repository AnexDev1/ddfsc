<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rule templates: Finance can add approved allowances to ALW without changing tax/pension code. -->
    <record id="category_basic" model="hr.salary.rule.category"><field name="name">Basic Salary</field><field name="code">BASIC</field></record>
    <record id="category_allowance" model="hr.salary.rule.category"><field name="name">Taxable Earnings</field><field name="code">ALW</field></record>
    <record id="category_pension_allowance" model="hr.salary.rule.category"><field name="name">Pensionable Allowances</field><field name="code">PENALW</field></record>
    <record id="category_non_taxable" model="hr.salary.rule.category"><field name="name">Non-taxable Cash Allowances</field><field name="code">NONTAX</field></record>
    <record id="category_gross" model="hr.salary.rule.category"><field name="name">Gross / Tax Base</field><field name="code">GROSS</field></record>
    <record id="category_deduction" model="hr.salary.rule.category"><field name="name">Employee Deductions</field><field name="code">DED</field></record>
    <record id="category_net" model="hr.salary.rule.category"><field name="name">Net Pay</field><field name="code">NET</field></record>
    <record id="category_employer" model="hr.salary.rule.category"><field name="name">Employer Contributions</field><field name="code">COMP</field></record>

    <record id="rule_basic_salary" model="hr.salary.rule"><field name="name">Basic Salary</field><field name="code">BASIC</field><field name="sequence">10</field><field name="category_id" ref="category_basic"/><field name="condition_select">none</field><field name="amount_select">code</field><field name="amount_python_compute">result = payslip.get_effective_basic_salary(contract)</field></record>
    <record id="rule_taxable_allowance" model="hr.salary.rule"><field name="name">Taxable Allowance</field><field name="code">TAX_ALLOW</field><field name="sequence">40</field><field name="category_id" ref="category_allowance"/><field name="condition_select">none</field><field name="amount_select">code</field><field name="amount_python_compute">result = inputs.TAX_ALLOW.amount</field></record>
    <record id="rule_pensionable_allowance" model="hr.salary.rule"><field name="name">Taxable and Pensionable Allowance</field><field name="code">PEN_ALLOW</field><field name="sequence">45</field><field name="category_id" ref="category_pension_allowance"/><field name="condition_select">none</field><field name="amount_select">code</field><field name="amount_python_compute">result = inputs.PEN_ALLOW.amount</field></record>
    <record id="rule_non_taxable_allowance" model="hr.salary.rule"><field name="name">Non-taxable Cash Allowance</field><field name="code">NONTAX_ALLOW</field><field name="sequence">50</field><field name="category_id" ref="category_non_taxable"/><field name="condition_select">none</field><field name="amount_select">code</field><field name="amount_python_compute">result = inputs.NONTAX_ALLOW.amount</field></record>
    <record id="rule_overtime_pay" model="hr.salary.rule"><field name="name">Approved Overtime Pay</field><field name="code">OT_PAY</field><field name="sequence">55</field><field name="category_id" ref="category_allowance"/><field name="condition_select">none</field><field name="amount_select">code</field><field name="amount_python_compute">result = inputs.OT_PAY.amount</field></record>
    <record id="rule_shift_differential" model="hr.salary.rule"><field name="name">Approved Shift Differential</field><field name="code">SHIFT_DIFF</field><field name="sequence">60</field><field name="category_id" ref="category_allowance"/><field name="condition_select">none</field><field name="amount_select">code</field><field name="amount_python_compute">result = inputs.SHIFT_DIFF.amount</field></record>
    <record id="rule_approved_deduction" model="hr.salary.rule"><field name="name">Approved Deduction or Adjustment</field><field name="code">OTHER_DED</field><field name="sequence">140</field><field name="category_id" ref="category_deduction"/><field name="condition_select">none</field><field name="amount_select">code</field><field name="amount_python_compute">result = -inputs.OTHER_DED.amount</field></record>
    <record id="rule_gross_tax_base" model="hr.salary.rule"><field name="name">Gross Taxable Earnings</field><field name="code">GROSS</field><field name="sequence">100</field><field name="category_id" ref="category_gross"/><field name="condition_select">none</field><field name="amount_select">code</field><field name="amount_python_compute">result = categories.BASIC + categories.ALW + categories.PENALW</field></record>
    <record id="rule_employee_pension" model="hr.salary.rule"><field name="name">Employee Pension</field><field name="code">ET_PENSION_EE</field><field name="sequence">120</field><field name="category_id" ref="category_deduction"/><field name="condition_select">none</field><field name="amount_select">code</field><field name="amount_python_compute">result = -payslip.get_ethiopian_pension(categories.BASIC + categories.PENALW)['employee']</field></record>
    <record id="rule_income_tax" model="hr.salary.rule"><field name="name">Employment Income Tax</field><field name="code">ET_PAYE</field><field name="sequence">130</field><field name="category_id" ref="category_deduction"/><field name="condition_select">none</field><field name="amount_select">code</field><field name="amount_python_compute">result = -payslip.get_ethiopian_monthly_tax(categories.GROSS)</field></record>
    <record id="rule_net_pay" model="hr.salary.rule"><field name="name">Net Pay</field><field name="code">NET</field><field name="sequence">200</field><field name="category_id" ref="category_net"/><field name="condition_select">none</field><field name="amount_select">code</field><field name="amount_python_compute">result = categories.GROSS + categories.NONTAX + categories.DED</field></record>
    <record id="rule_employer_pension" model="hr.salary.rule"><field name="name">Employer Pension Contribution</field><field name="code">ET_PENSION_ER</field><field name="sequence">210</field><field name="category_id" ref="category_employer"/><field name="condition_select">none</field><field name="amount_select">code</field><field name="amount_python_compute">result = payslip.get_ethiopian_pension(categories.BASIC + categories.PENALW)['employer']</field></record>

    <record id="input_taxable_allowance" model="hr.rule.input"><field name="name">Taxable Allowance</field><field name="code">TAX_ALLOW</field><field name="input_id" ref="rule_taxable_allowance"/></record>
    <record id="input_pensionable_allowance" model="hr.rule.input"><field name="name">Taxable and Pensionable Allowance</field><field name="code">PEN_ALLOW</field><field name="input_id" ref="rule_pensionable_allowance"/></record>
    <record id="input_non_taxable_allowance" model="hr.rule.input"><field name="name">Non-taxable Cash Allowance</field><field name="code">NONTAX_ALLOW</field><field name="input_id" ref="rule_non_taxable_allowance"/></record>
    <record id="input_overtime_pay" model="hr.rule.input"><field name="name">Approved Overtime Pay</field><field name="code">OT_PAY</field><field name="input_id" ref="rule_overtime_pay"/></record>
    <record id="input_shift_differential" model="hr.rule.input"><field name="name">Approved Shift Differential</field><field name="code">SHIFT_DIFF</field><field name="input_id" ref="rule_shift_differential"/></record>
    <record id="input_approved_deduction" model="hr.rule.input"><field name="name">Approved Deduction or Adjustment</field><field name="code">OTHER_DED</field><field name="input_id" ref="rule_approved_deduction"/></record>

    <record id="component_type_taxable_allowance" model="ddfsc.payroll.component.type"><field name="name">Taxable Allowance</field><field name="code">TAX_ALLOW</field><field name="component_kind">earning</field><field name="salary_rule_id" ref="rule_taxable_allowance"/><field name="taxable" eval="True"/><field name="pensionable" eval="False"/><field name="note">Use only after Finance confirms the allowance is taxable and not pensionable.</field></record>
    <record id="component_type_pensionable_allowance" model="ddfsc.payroll.component.type"><field name="name">Taxable and Pensionable Allowance</field><field name="code">PEN_ALLOW</field><field name="component_kind">earning</field><field name="salary_rule_id" ref="rule_pensionable_allowance"/><field name="taxable" eval="True"/><field name="pensionable" eval="True"/><field name="note">Use only after Finance confirms the allowance forms part of the tax and pension base.</field></record>
    <record id="component_type_non_taxable_allowance" model="ddfsc.payroll.component.type"><field name="name">Non-taxable Cash Allowance</field><field name="code">NONTAX_ALLOW</field><field name="component_kind">earning</field><field name="salary_rule_id" ref="rule_non_taxable_allowance"/><field name="taxable" eval="False"/><field name="pensionable" eval="False"/><field name="note">Use only where the exemption and supporting evidence are approved.</field></record>
    <record id="component_type_shift_differential" model="ddfsc.payroll.component.type"><field name="name">Shift Differential</field><field name="code">SHIFT_DIFF</field><field name="component_kind">earning</field><field name="salary_rule_id" ref="rule_shift_differential"/><field name="taxable" eval="True"/><field name="pensionable" eval="False"/><field name="note">Use for a documented HR-approved shift differential. Confirm tax and pension treatment with Finance before use.</field></record>
    <record id="component_type_approved_deduction" model="ddfsc.payroll.component.type"><field name="name">Approved Deduction or Adjustment</field><field name="code">OTHER_DED</field><field name="component_kind">deduction</field><field name="salary_rule_id" ref="rule_approved_deduction"/><field name="taxable" eval="False"/><field name="pensionable" eval="False"/><field name="note">Use for an approved salary advance recovery, correction, or other documented deduction. Record the approval reference in the employee component note.</field></record>

    <record id="structure_ethiopian_monthly" model="hr.payroll.structure"><field name="name">DDFSC Ethiopian Monthly Payroll</field><field name="code">DDFSC_ET_MONTHLY</field><field name="company_id" ref="base.main_company"/><field name="rule_ids" eval="[(6, 0, [ref('rule_basic_salary'), ref('rule_taxable_allowance'), ref('rule_pensionable_allowance'), ref('rule_non_taxable_allowance'), ref('rule_overtime_pay'), ref('rule_shift_differential'), ref('rule_gross_tax_base'), ref('rule_employee_pension'), ref('rule_income_tax'), ref('rule_approved_deduction'), ref('rule_net_pay'), ref('rule_employer_pension')])]"/></record>
    <function model="ddfsc.ethiopian.tax.band" name="ensure_salary_rule_templates"/>
</odoo>
